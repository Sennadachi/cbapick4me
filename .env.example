# Copy to .env and fill in. Never commit .env.

# DigiKey: developer.digikey.com → create a Production app with "Product Information v4".
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_SITE=UK
# DIGIKEY_SANDBOX=true

# Blank = the DigiKey site's currency (UK → GBP, DE → EUR, US → USD)
CBAPICK_CURRENCY=

# --- web hosting (cbapick4me --serve) ---
CBAPICK_HOST=0.0.0.0
CBAPICK_PORT=8080
# Long random string; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CBAPICK_STORAGE_SECRET=
CBAPICK_MAX_ROWS=500
# Pick runs allowed per client IP per hour (0 = unlimited).
CBAPICK_RATE_PER_HOUR=20
# CBAPICK_CACHE_DIR=/data/cache
